{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Jupyter Notebook",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--with", "notebook", "jupyter", "notebook", "--notebook-dir=notebook", "--port=8888", "--no-browser"],
      "port": 8888
    },
    {
      "name": "Pipeline HTML (docs)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8000", "--directory", "docs"],
      "port": 8000
    }
  ]
}
